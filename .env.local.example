# Sepolia (11155111)
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_PUBLIC_CONTRACT=0xYOUR_PUBLIC_CONTRACT
# Optional: display a vault address
NEXT_PUBLIC_VAULT_CONTRACT=0xYOUR_VAULT_CONTRACT

# RPC (used server-side if needed)
RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# EIP-712 signer (server-only; DO NOT COMMIT a real key)
SIGNER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
CLAIM_DOMAIN_NAME=EICClaims
CLAIM_DOMAIN_VERSION=1

# Default mode: eip712 (or 'merkle')
CLAIM_MODE=eip712
 
# Public base URL for QR claim links
NEXT_PUBLIC_BASE_URL=https://<your-dapp-domain>
