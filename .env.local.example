# Base Mainnet (8453)
NEXT_PUBLIC_CHAIN_ID=8453

# Contracts (Base mainnet)
# Token contract (EIC)
NEXT_PUBLIC_PUBLIC_CONTRACT=0xEIC_TOKEN_ADDRESS_ON_BASE

# Optional: vault address (if deployed)
NEXT_PUBLIC_VAULT_CONTRACT=0xEIC_VAULT_ADDRESS_ON_BASE

# RPC (server-side)
# Use a Base mainnet RPC from a provider you trust (Alchemy/Infura/QuickNode/etc)
RPC_URL=https://base-mainnet.rpc.provider.example/YOUR_KEY

# EIP-712 signer (server-only; DO NOT COMMIT a real key)
SIGNER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
CLAIM_DOMAIN_NAME=EICClaims
CLAIM_DOMAIN_VERSION=1

# Default mode: eip712 (or 'merkle')
CLAIM_MODE=eip712

# Public base URL for QR claim links
NEXT_PUBLIC_BASE_URL=https://<your-dapp-domain>
